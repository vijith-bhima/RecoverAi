# RecoverAI repository ignore rules
# Keep credentials, local data, generated output, and machine-specific files
# out of GitHub. Commit source code, tests, lockfiles, and .env.example only.

# Secrets and local environment files
.env
.env.*
!.env.example
*.secret
*.secrets
*.key
*.pem
*.p12
credentials.json
service-account*.json

# Local databases and SQLite sidecars (never commit customer/payment data)
*.db
*.sqlite
*.sqlite3
*.db-*
recoverai.db

# Logs, exports, reports, and generated runtime output
*.log
output/
reports/
tmp/
temp/

# Python caches, environments, and build artifacts
__pycache__/
*.py[cod]
*.pyo
*.pyd
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
*.egg-info/
dist/
build/
.venv/
venv/
env/

# Frontend dependencies and build output
frontend/node_modules/
frontend/.next/
frontend/out/
frontend/.turbo/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Local tunnel/deployment configuration
ngrok.yml
.ngrok/
.vercel/
.render/

# Streamlit local state
.streamlit/

# IDE, OS, and local assistant metadata
.idea/
.vscode/
.DS_Store
Thumbs.db
*.swp
*.swo
.codex/
.agents/

# Local shell wrappers generated by the development environment
/powershell.bat
/powershell.cmd
/frontend/powershell.bat
/frontend/powershell.cmd
/frontend/AGENTS.md
/frontend/CLAUDE.md

# Local TypeScript metadata
frontend/tsconfig.tsbuildinfo
