# .env.example — copy this to `.env` and fill in real values.
# NEVER commit your actual .env file to git.

# ── LLM providers ──────────────────────────────────────────────────────────────
# Groq (free tier) — get a key at https://console.groq.com
GROQ_API_KEY=your_key_here
GROQ_MODEL=llama-3.1-8b-instant      # free on Groq — see console.groq.com/docs/models

# Ollama (local fallback) — run `ollama pull llama3` once, then point here
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# Which LLM provider to use: "mock" | "groq" | "ollama"
LLM_PROVIDER=mock

# ── Database ────────────────────────────────────────────────────────────────────
DATABASE_URL=recoverai.db           # SQLite path relative to project root

# ── Authentication & password reset ─────────────────────────────────────────
RECOVERAI_ENVIRONMENT=development   # production disables demo reset links
RECOVERAI_ENABLE_DEMO_DATA=0        # set to 1 only for an explicit local demo
JWT_SECRET_KEY=replace_with_random_32_plus_character_secret
APP_BASE_URL=http://localhost:3000  # public frontend URL used in reset links
PUBLIC_API_URL=http://localhost:8000 # externally reachable webhook/API origin
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
RECOVERAI_ENABLE_RAZORPAY_SYNC=0     # webhooks are real-time; enable polling only when needed
AGENT_POLL_SECONDS=15
RECOVERAI_AGENT_ENABLED=1           # one API worker owns the local scheduler

# SMTP is required in production to deliver password reset emails
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_FROM=security@example.com
SMTP_USERNAME=
SMTP_PASSWORD=

# ── Guardrail limits (change here, not in code) ────────────────────────────────
MAX_AUTONOMOUS_AMOUNT=10000         # ₹ — above this, always escalate to human
MAX_RETRY_ATTEMPTS=3                # max times we retry the same payment
RETRY_COOLDOWN_HOURS=6              # minimum hours between retry attempts
MAX_CONTACT_ATTEMPTS=2              # max times we contact the same customer

# ── Logging ─────────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO                      # DEBUG | INFO | WARNING | ERROR
LOG_FILE=recoverai.log              # set to empty string to disable file logging
